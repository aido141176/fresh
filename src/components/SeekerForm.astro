---
import locationData from '../data/bali.json';
---


<div class="bg-slate-800 border border-slate-700 rounded-2xl shadow-xl p-6">
  <div class="border-b border-slate-700 pb-4 mb-6">
    <h2 class="text-xl font-bold text-white">Create Seeker Profile Matcher</h2>
    <p class="text-slate-400 text-xs mt-1">Configure your budget constraints and target living arrangements in Bali.</p>
  </div>

  <div id="form-alert" class="hidden mb-6 p-4 rounded-xl text-sm font-medium"></div>

  <!-- Tab Navigation System -->
<div class="flex border-b border-slate-700 mb-6 gap-2">
  <button type="button" id="tab-btn-search" class="px-4 py-2 text-sm font-semibold border-b-2 border-indigo-500 text-white transition-all">Quick Village Search</button>
  <button type="button" id="tab-btn-manual" class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-white transition-all">Manual Location Filters</button>
</div>


<div id="tab-panel-search" class="block space-y-4">
  <!-- (Existing content) -->
   <h1>hfhfhf</h1>
</div>

<div id="tab-panel-manual" class="hidden space-y-4">
  <!-- (Existing content) -->
   <h2>kjkjkj</h2>




  <!-- Reverse Lookup Input Interface Box -->
  <div class="mb-6 p-5 bg-slate-900/60 border border-indigo-500/20 rounded-xl space-y-4">
    <div>
      <h3 class="text-sm font-bold text-indigo-400">Don't know the Regency or District?</h3>
      <p class="text-slate-400 text-xs mt-0.5">Type any popular Bali village or neighborhood below to auto-fill the whole form instantly.</p>
    </div>

    <div class="relative">
      <input type="text" id="geo-search-input" placeholder="e.g. Canggu, Berawa, Ubud, Bingin..." class="w-full h-11 pl-4 pr-12 bg-slate-800 border border-slate-700 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm" />
      <div id="search-status-icon" class="absolute inset-y-0 right-0 flex items-center pr-4 hidden">
        <span class="text-emerald-400 font-bold text-lg">✓</span>
      </div>
    </div>

    <div id="search-results-box" class="hidden max-h-48 overflow-y-auto bg-slate-800 border border-slate-700 rounded-xl divide-y divide-slate-700/50 shadow-2xl text-sm"></div>

    <div id="injector-confirmation" class="hidden flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-800/80 border border-emerald-500/20 p-3 rounded-lg">
      <p id="injector-text" class="text-xs text-slate-300"></p>
      <button type="button" id="inject-location-btn" class="h-8 px-4 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg shadow-sm transition-all whitespace-nowrap">
        Enter Location Data
      </button>
    </div>
  </div>













</div>





  <form id="seeker-form" class="space-y-6">
    
 

    <div class="bg-slate-900/20 border border-slate-700 p-4 rounded-xl space-y-5">
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider border-b border-slate-700 pb-2">Target Housing Location Preferences</h3>
      
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-3">1. Preferred Regency</label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
          {locationData.map((reg) => (
            <label class="flex items-center gap-2 p-2.5 bg-slate-900/60 border border-slate-700 rounded-lg cursor-pointer hover:bg-slate-900 transition-all text-xs font-medium select-none">
              <input type="radio" name="regency" value={reg.regency_name} class="w-4 h-4 text-indigo-600 bg-slate-900 border-slate-700 focus:ring-indigo-500 focus:ring-offset-slate-900 focus:ring-2" />
              <span class="text-slate-200">{reg.regency_name}</span>
            </label>
          ))}
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-3">2. Preferred District</label>
        <div id="district-radio-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 p-3 bg-slate-900/40 border border-slate-700/60 rounded-xl text-xs text-slate-500 italic">
          Select a Regency to see districts...
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-3">3. Preferred Village / Ward</label>
        <div id="village-radio-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 p-3 bg-slate-900/40 border border-slate-700/60 rounded-xl text-xs text-slate-500 italic max-h-48 overflow-y-auto">
          Select a District to see villages...
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-3">4. Targeted Specific Neighborhoods / Banjars (Group Checkboxes)</label>
        <div id="neighborhood-checkbox-grid" class="p-4 bg-slate-900 border border-slate-700 rounded-xl grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-500 italic">
          Select a village to check off neighborhoods...
        </div>
      </div>
    </div>

    <div class="bg-slate-900/20 border border-slate-700 p-4 rounded-xl space-y-3">
      <label for="budget-input" class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Maximum Monthly Target Budget (IDR)</label>
      <div class="relative rounded-xl shadow-sm">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
          <span class="text-slate-400 text-sm font-semibold">Rp</span>
        </div>
        <input type="number" id="budget-input" required min="100000" step="50000" placeholder="e.g. 5000000" class="w-full h-11 pl-11 pr-24 bg-slate-900 border border-slate-700 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all font-semibold" />
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
          <span id="budget-formatted" class="text-xs text-indigo-400 font-bold font-mono"></span>
        </div>
      </div>
    </div>



       <div class="flex items-start gap-3 bg-slate-900/40 border border-slate-700 p-4 rounded-xl">
      <input type="checkbox" id="publish-profile" name="publish_profile" class="w-5 h-5 mt-0.5 text-indigo-600 bg-slate-800 border-slate-700 rounded focus:ring-indigo-500 focus:ring-offset-slate-900 focus:ring-2" />
      <div>
        <label for="publish-profile" class="text-sm font-semibold text-white cursor-pointer select-none">Publish Profile to Seekers Feed</label>
        <p class="text-slate-400 text-xs mt-0.5">Toggle this setting ON to allow matching landlords and potential flatmates to discover your profile publicly.</p>
      </div>
    </div>

    <div class="bg-slate-900/20 border border-slate-700 p-4 rounded-xl space-y-3">
      <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Profile Photo Upload</label>
      <div class="flex items-center gap-4">
        <div id="avatar-preview" class="w-16 h-16 rounded-xl bg-slate-700 border border-slate-600 flex items-center justify-center text-slate-400 text-xs text-center font-semibold overflow-hidden">
          No Image
        </div>
        <div class="flex-1">
          <input type="file" id="profile-image-file" accept="image/png, image/jpeg, image/jpg" class="block w-full text-xs text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-600 file:text-white file:cursor-pointer hover:file:bg-indigo-500 transition-all" />
          <p class="text-[11px] text-slate-500 mt-1.5">Supports PNG or JPG formats.</p>
        </div>
      </div>
      <input type="hidden" id="wp-media-id" name="profile_image_id" value="" />
    </div>



    <div class="flex justify-end pt-4 border-t border-slate-700">
      <button type="submit" id="submit-btn" class="h-11 px-6 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-xl shadow-md transition-all focus:ring-2 focus:ring-indigo-500">
        Save Profile Settings
      </button>
    </div>

  </form>
</div>

<script define:vars={{ locationData }}>
  window.BALI_LOCATIONS = locationData;
</script>

<!-- Clean ESM import layout link connects your frontend directly to your script file -->
<script>
  import "./seeker-logic.js";
</script>


<script>
  const btns = { search: document.getElementById('tab-btn-search'), manual: document.getElementById('tab-btn-manual') };
  const panels = { search: document.getElementById('tab-panel-search'), manual: document.getElementById('tab-panel-manual') };

  function setTab(active: any, inactive: any) {
    [active, inactive].forEach(t => t.btn.classList.toggle('border-indigo-500', t === active));
    [active, inactive].forEach(t => t.btn.classList.toggle('border-transparent', t === inactive));
    active.panel.classList.remove('hidden'); inactive.panel.classList.add('hidden');
  }

  btns.search?.addEventListener('click', () => setTab({btn: btns.search, panel: panels.search}, {btn: btns.manual, panel: panels.manual}));
  btns.manual?.addEventListener('click', () => setTab({btn: btns.manual, panel: panels.manual}, {btn: btns.search, panel: panels.search}));
</script>
