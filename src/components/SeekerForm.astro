---
// src/components/SeekerForm.astro
import locationData from '../data/bali.json';
---

<!-- Main Dynamic Form Wrapper Card -->
<div class="bg-slate-800 border border-slate-700 rounded-2xl shadow-xl p-6">
  <div class="border-b border-slate-700 pb-4 mb-6">
    <h2 class="text-xl font-bold text-white">Create Seeker Profile Matcher</h2>
    <p class="text-slate-400 text-xs mt-1">Configure your budget constraints and target living arrangements in Bali.</p>
  </div>

  <!-- Action Alerts -->
  <div id="form-alert" class="hidden mb-6 p-4 rounded-xl text-sm font-medium"></div>

  <form id="seeker-form" class="space-y-6">
    
    <!-- 1. True/False Profile Visibility Toggle -->
    <div class="flex items-start gap-3 bg-slate-900/40 border border-slate-700 p-4 rounded-xl">
      <input type="checkbox" id="publish-profile" name="publish_profile" class="w-5 h-5 mt-0.5 text-indigo-600 bg-slate-800 border-slate-700 rounded focus:ring-indigo-500 focus:ring-offset-slate-900 focus:ring-2" />
      <div>
        <label for="publish-profile" class="text-sm font-semibold text-white cursor-pointer select-none">Publish Profile to Seekers Feed</label>
        <p class="text-slate-400 text-xs mt-0.5">Toggle this setting ON to allow matching landlords and potential flatmates to discover your profile publicly.</p>
      </div>
    </div>

    <!-- 2. Profile Image Binary Asset Controller -->
    <div class="bg-slate-900/20 border border-slate-700 p-4 rounded-xl space-y-3">
      <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Profile Photo Upload</label>
      <div class="flex items-center gap-4">
        <div id="avatar-preview" class="w-16 h-16 rounded-xl bg-slate-700 border border-slate-600 flex items-center justify-center text-slate-400 text-xs text-center font-semibold overflow-hidden">
          No Image
        </div>
        <div class="flex-1">
          <input type="file" id="profile-image-file" accept="image/png, image/jpeg, image/jpg" class="block w-full text-xs text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-600 file:text-white file:cursor-pointer hover:file:bg-indigo-500 transition-all" />
          <p class="text-[11px] text-slate-500 mt-1.5">Supports PNG or JPG formats. WordPress will automatically crop and scale resolutions cleanly.</p>
        </div>
      </div>
      <!-- Hidden parameter field storing active Media ID asset pointers -->
      <input type="hidden" id="wp-media-id" name="profile_image_id" value="" />
    </div>

    <!-- 3. Dynamic Location Cascade Engine -->
    <div class="bg-slate-900/20 border border-slate-700 p-4 rounded-xl space-y-4">
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider border-b border-slate-700 pb-2">Target Housing Location Preferences</h3>
      
      <!-- Regency Radio Strip Grid Container -->
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-3">1. Preferred Regency</label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
          {locationData.map((reg) => (
            <label class="flex items-center gap-2 p-2.5 bg-slate-900/60 border border-slate-700 rounded-lg cursor-pointer hover:bg-slate-900 transition-all text-sm select-none">
              <input type="radio" name="regency" value={reg.regency_name} class="w-4 h-4 text-indigo-600 bg-slate-800 border-slate-700 focus:ring-indigo-500 focus:ring-offset-slate-900 focus:ring-2" />
              <span class="text-slate-200">{reg.regency_name}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- District Selective Input Dropdown Matrix -->
      <div>
        <label for="select-district" class="block text-xs font-semibold text-slate-300 mb-2">2. Preferred District</label>
        <select id="select-district" disabled class="w-full h-11 px-3 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all disabled:opacity-40 disabled:cursor-not-allowed">
          <option value="">Select Regency first</option>
        </select>
      </div>

      <!-- Village Selective Input Dropdown Matrix -->
      <div>
        <label for="select-village" class="block text-xs font-semibold text-slate-300 mb-2">3. Preferred Village / Ward</label>
        <select id="select-village" disabled class="w-full h-11 px-3 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all disabled:opacity-40 disabled:cursor-not-allowed">
          <option value="">Select District first</option>
        </select>
      </div>

      <!-- Multi-Select Neighborhood Options Checkbox Array Frame -->
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-2">4. Targeted Specific Neighborhoods / Banjars (Select Multiple)</label>
        <div id="neighborhood-checkbox-grid" class="p-4 bg-slate-900 border border-slate-700 rounded-xl grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-400 italic">
          Select a village to reveal hyper-local neighborhoods...
        </div>
      </div>
    </div>

    <!-- 4. Budget Tracking Field Layout -->
    <div class="bg-slate-900/20 border border-slate-700 p-4 rounded-xl space-y-3">
      <label for="budget-input" class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Maximum Monthly Target Budget (IDR)</label>
      <div class="relative rounded-xl shadow-sm">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
          <span class="text-slate-400 text-sm font-semibold">Rp</span>
        </div>
        <input type="number" id="budget-input" required min="100000" step="50000" placeholder="e.g. 5000000" class="w-full h-11 pl-11 pr-24 bg-slate-900 border border-slate-700 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all font-semibold" />
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
          <span id="budget-formatted" class="text-xs text-indigo-400 font-bold font-mono"></span>
        </div>
      </div>
    </div>

    <!-- Submission Trigger Buttons -->
    <div class="flex justify-end pt-4 border-t border-slate-700">
      <button type="submit" id="submit-btn" class="h-11 px-6 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-xl shadow-md transition-all focus:ring-2 focus:ring-indigo-500">
        Save Profile Settings
      </button>
    </div>

  </form>
</div>

<!-- Expose local location data object parsing cleanly down to browser window threads -->
<script define:vars={{ locationData }}>
  window.BALI_LOCATIONS = locationData;
</script>

<script>
  // 1. Budget Rupiah Live Format Listener Action
  const budgetInput = document.getElementById('budget-input');
  const budgetFormatted = document.getElementById('budget-formatted');

  if (budgetInput && budgetFormatted) {
    budgetInput.addEventListener('input', (e) => {
      const val = parseInt((e.target as HTMLInputElement).value);
      if (val && val > 0) {
        budgetFormatted.textContent = new Intl.NumberFormat('id-ID', {
          style: 'currency',
          currency: 'IDR',
          minimumFractionDigits: 0,
          maximumFractionDigits: 0
        }).format(val);
      } else {
        budgetFormatted.textContent = '';
      }
    });
  }

  // 2. Location Dropdown Cascading Logic Engine
  const regencyRadios = document.getElementsByName('regency');
  const districtSelect = document.getElementById('select-district') as HTMLSelectElement;
  const villageSelect = document.getElementById('select-village') as HTMLSelectElement;
  const checkboxGrid = document.getElementById('neighborhood-checkbox-grid');

  let activeRegencyObj: any = null;
  let activeDistrictObj: any = null;
  let activeVillageObj: any = null;

  // Regency Change Handler
  regencyRadios.forEach(radio => {
    radio.addEventListener('change', (e) => {
      const selectedRegency = (e.target as HTMLInputElement).value;
      
      districtSelect.innerHTML = '<option value="">Select District</option>';
      villageSelect.innerHTML = '<option value="">Select District first</option>';
      districtSelect.disabled = true;
      villageSelect.disabled = true;
      if (checkboxGrid) checkboxGrid.innerHTML = '<span class="text-xs text-slate-500 italic">Select a village to reveal hyper-local neighborhoods...</span>';

      activeRegencyObj = (window as any).BALI_LOCATIONS.find((r: any) => r.regency_name === selectedRegency);
      if (activeRegencyObj?.districts) {
        activeRegencyObj.districts.forEach((d: any) => {
          const opt = document.createElement('option');
          opt.value = d.district_name;
          opt.textContent = d.district_name;
          districtSelect.appendChild(opt);
        });
        districtSelect.disabled = false;
      }
    });
  });

  // District Change Handler
  if (districtSelect) {
    districtSelect.addEventListener('change', (e) => {
      const selectedDistrict = (e.target as HTMLSelectElement).value;
      
      villageSelect.innerHTML = '<option value="">Select Village</option>';
      villageSelect.disabled = true;
      if (checkboxGrid) checkboxGrid.innerHTML = '<span class="text-xs text-slate-500 italic">Select a village to reveal hyper-local neighborhoods...</span>';

      if (!selectedDistrict) return;

      activeDistrictObj = activeRegencyObj?.districts.find((d: any) => d.district_name === selectedDistrict);
      if (activeDistrictObj?.villages) {
        activeDistrictObj.villages.forEach((v: any) => {
          const opt = document.createElement('option');
          opt.value = v.village_name;
          opt.textContent = v.village_name;
          villageSelect.appendChild(opt);
        });
        villageSelect.disabled = false;
      }
    });
  }

