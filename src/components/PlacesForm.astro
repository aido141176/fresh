---
import locationData from '../data/bali.json';
---

<div class="max-w-5xl mx-auto p-6 bg-white rounded-xl shadow-md border border-slate-100 my-8">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">List Your Property</h2>
    <p class="text-slate-500 text-sm mt-1">Provide your property's exact location parameters below.</p>
  </div>

  <form class="space-y-6">
    <!-- 1. Dropdown Row (Fixed layout wrapper to scale evenly across screen sizes) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Regency Select -->
      <div>
        <label for="p-regency" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2">Regency</label>
        <select id="p-regency" name="regency" class="w-full h-11 px-3 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all">
          <option value="">Select Regency</option>
          {locationData.map((regency) => (
            <option value={regency.regency_name}>{regency.regency_name}</option>
          ))}
        </select>
      </div>

      <!-- District Select -->
      <div>
        <label for="p-district" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2">District</label>
        <select id="p-district" name="district" disabled class="w-full h-11 px-3 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all disabled:opacity-50 disabled:bg-slate-100 disabled:cursor-not-allowed">
          <option value="">Select District</option>
        </select>
      </div>

      <!-- Village Select -->
      <div>
        <label for="p-village" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2">Village / Sub-district</label>
        <select id="p-village" name="village" disabled class="w-full h-11 px-3 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all disabled:opacity-50 disabled:bg-slate-100 disabled:cursor-not-allowed">
          <option value="">Select Village</option>
        </select>
      </div>

      <!-- Neighborhood Select -->
      <div>
        <label for="p-neighborhood" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2">Neighborhood</label>
        <select id="p-neighborhood" name="neighborhood" disabled class="w-full h-11 px-3 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all disabled:opacity-50 disabled:bg-slate-100 disabled:cursor-not-allowed">
          <option value="">Select Neighborhood</option>
        </select>
      </div>
    </div>

    <!-- 2. Address Details & Postcode Row -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 pt-2">
      <!-- Street Address -->
      <div class="md:col-span-2">
        <label for="p-street" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2">Street Name</label>
        <input type="text" id="p-street" name="street" placeholder="e.g. Jalan Raya Canggu" class="w-full h-11 px-4 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all" />
      </div>

      <!-- Street/Unit Number -->
      <div>
        <label for="p-number" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2">No. / Unit</label>
        <input type="text" id="p-number" name="number" placeholder="e.g. 45B" class="w-full h-11 px-4 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all" />
      </div>

      <!-- Postcode Input Box -->
      <div>
        <label for="p-postcode" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2">Postcode</label>
        <input type="text" id="p-postcode" name="postcode" readonly value="-" placeholder="-" class="w-full h-11 px-4 bg-slate-100 border border-slate-200 rounded-lg text-slate-500 font-mono focus:outline-none cursor-not-allowed select-none" />
      </div>
    </div>

    <!-- Submit Button Box -->
    <div class="flex justify-end pt-4 border-t border-slate-100">
      <button type="submit" class="h-11 px-6 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition-all focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
        Save Property Listing
      </button>
    </div>
  </form>
</div>

<script define:vars={{ locationData }}>
  const regencySelect = document.getElementById('p-regency');
  const districtSelect = document.getElementById('p-district');
  const villageSelect = document.getElementById('p-village');
  const neighborhoodSelect = document.getElementById('p-neighborhood');
  const postcodeField = document.getElementById('p-postcode');

  // 1. Regency Selection Trigger
  regencySelect.addEventListener('change', (e) => {
    const selectedRegencyName = e.target.value;
    
    // Clear all children elements downstream
    districtSelect.innerHTML = '<option value="">Select District</option>';
    villageSelect.innerHTML = '<option value="">Select Village</option>';
    neighborhoodSelect.innerHTML = '<option value="">Select Neighborhood</option>';
    
    districtSelect.disabled = true;
    villageSelect.disabled = true;
    neighborhoodSelect.disabled = true;
    postcodeField.value = '-';

    if (!selectedRegencyName) return;

    const regencyObj = locationData.find(r => r.regency_name === selectedRegencyName);
    
    if (regencyObj && regencyObj.districts) {
      regencyObj.districts.forEach(dist => {
        const el = document.createElement('option');
        el.value = dist.district_name;
        el.textContent = dist.district_name;
        districtSelect.appendChild(el);
      });
      districtSelect.disabled = false;
    }
  });

  // 2. District Selection Trigger
  districtSelect.addEventListener('change', (e) => {
    const selectedRegencyName = regencySelect.value;
    const selectedDistrictName = e.target.value;

    villageSelect.innerHTML = '<option value="">Select Village</option>';
    neighborhoodSelect.innerHTML = '<option value="">Select Neighborhood</option>';
    
    villageSelect.disabled = true;
    neighborhoodSelect.disabled = true;
    postcodeField.value = '-';

    if (!selectedDistrictName) return;

    const regencyObj = locationData.find(r => r.regency_name === selectedRegencyName);
    const districtObj = regencyObj?.districts.find(d => d.district_name === selectedDistrictName);

    if (districtObj && districtObj.villages) {
      districtObj.villages.forEach(vil => {
        const el = document.createElement('option');
        el.value = vil.village_name;
        el.textContent = vil.village_name;
        el.setAttribute('data-pc', vil.postal_code || vil.postcode);
        villageSelect.appendChild(el);
      });
      villageSelect.disabled = false;
    }
  });

  // 3. Village Selection Trigger (Updates Postcode field & unlocks Neighborhood options)
  villageSelect.addEventListener('change', (e) => {
    const selectedRegencyName = regencySelect.value;
    const selectedDistrictName = districtSelect.value;
    const selectedVillageName = e.target.value;
    const activeOption = e.target.selectedOptions[0];
    
    neighborhoodSelect.innerHTML = '<option value="">Select Neighborhood</option>';
    neighborhoodSelect.disabled = true;

    if (!selectedVillageName) {
      postcodeField.value = '-';
      return;
    }

    // Set postal code
    const code = activeOption.getAttribute('data-pc');
    postcodeField.value = code || '-';

    // Query JSON tree to locate neighborhood strings
    const regencyObj = locationData.find(r => r.regency_name === selectedRegencyName);
    const districtObj = regencyObj?.districts.find(d => d.district_name === selectedDistrictName);
    const villageObj = districtObj?.villages.find(v => v.village_name === selectedVillageName);

    if (villageObj && villageObj.neighborhoods && villageObj.neighborhoods.length > 0) {
      villageObj.neighborhoods.forEach(nh => {
        const el = document.createElement('option');
        el.value = nh;
        el.textContent = nh;
        neighborhoodSelect.appendChild(el);
      });
      neighborhoodSelect.disabled = false;
    }
  });
</script>
