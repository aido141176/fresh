---
// src/pages/users.astro
import locationData from '../../data/bali.json';

const token = Astro.cookies.get('wp_jwt_token')?.value;
let userProfile = null;
let connectionError = null;

if (token) {
  try {
    // Add a real browser signature to try and slide past basic server firewall blocks
    const response = await fetch('https://amcd.com.au', {
      headers: { 
        'Authorization': `Bearer ${token}`,
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36'
      }
    });
    
    if (response.ok) {
      userProfile = await response.json();
    } else {
      // If the token is rejected with a 401, wipe the stale cookie session cleanly
      Astro.cookies.delete('wp_jwt_token', { path: '/' });
    }
  } catch (error) {
    // Prevents a 502/500 from crashing the whole page if your host blocks Vercel's IP
    console.error("WordPress connection dropped by host firewall:", error);
    connectionError = "Unable to connect to the profile server. Please check your firewall configurations.";
  }
}
