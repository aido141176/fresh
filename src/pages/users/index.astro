---
// src/pages/users/index.astro
// Clean server-side frontmatter block with no external dependencies

import '../../../style/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Accounts Authentication</title>

</head>
<body class="bg-slate-900 min-h-screen text-slate-100 flex flex-col items-center justify-center p-4">

  <div class="w-full max-w-md bg-slate-800 rounded-2xl border border-slate-700 shadow-xl p-6">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-white">Flatmates Dashboard</h2>
      <p class="text-slate-400 text-sm mt-1">Authentication check panel via headless WordPress.</p>
    </div>

    <!-- 1. Authenticated Status View Panel (Hidden by default) -->
    <div id="dashboard-view" class="hidden space-y-4">
      <div class="p-4 bg-emerald-500/10 border border-emerald-500/20 rounded-xl">
        <p class="text-emerald-400 font-medium text-sm">✓ Connected Successfully</p>
        <p id="welcome-message" class="text-white text-lg font-bold mt-1">Hello!</p>
      </div>
      
      <div class="p-3 bg-slate-900/50 rounded-lg border border-slate-700 font-mono text-xs text-slate-400 space-y-1">
        <p id="user-email-display"></p>
        <p id="user-nicename-display"></p>
      </div>

      <button id="logout-btn" class="w-full h-11 bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-xl transition-all">
        Sign Out Safely
      </button>
    </div>

    <!-- 2. Logged Out Form Input Panel -->
    <div id="login-view" class="space-y-4">
      <div id="error-alert" class="hidden p-3 bg-red-500/10 border border-red-500/30 rounded-lg text-xs font-medium text-red-400"></div>

      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Username or Email</label>
          <input type="text" id="username" required autocomplete="username" class="w-full h-11 px-4 bg-slate-900 border border-slate-700 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" />
        </div>
        
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Password</label>
          <input type="password" id="password" required autocomplete="current-password" class="w-full h-11 px-4 bg-slate-900 border border-slate-700 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" />
        </div>

        <button type="submit" class="w-full h-11 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-xl shadow-md transition-all pt-1">
          Sign In Account
          </button>
      </form>
    </div>
  </div>

  <script>
    const loginForm = document.getElementById('login-form');
    const logoutBtn = document.getElementById('logout-btn');
    const errorAlert = document.getElementById('error-alert');
    const loginView = document.getElementById('login-view');
    const dashboardView = document.getElementById('dashboard-view');
    const welcomeMessage = document.getElementById('welcome-message');
    const emailDisplay = document.getElementById('user-email-display');
    const nicenameDisplay = document.getElementById('user-nicename-display');

    // On initial page load, check if a valid session token exists in local storage
    const storedToken = localStorage.getItem('wp_session_token');
    const storedName = localStorage.getItem('wp_user_name');
    const storedEmail = localStorage.getItem('wp_user_email');
    const storedNicename = localStorage.getItem('wp_user_nicename');

    if (storedToken && loginView && dashboardView && welcomeMessage && emailDisplay && nicenameDisplay) {
      loginView.classList.add('hidden');
      dashboardView.classList.remove('hidden');
      welcomeMessage.textContent = `Hello, ${storedName}!`;
      emailDisplay.innerHTML = `<strong>Email:</strong> ${storedEmail}`;
      nicenameDisplay.innerHTML = `<strong>Slug:</strong> ${storedNicename}`;
    }

    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorAlert) errorAlert.classList.add('hidden');

        const usernameEl = document.getElementById('username');
        const passwordEl = document.getElementById('password');
        
        if (usernameEl instanceof HTMLInputElement && passwordEl instanceof HTMLInputElement) {
          const username = usernameEl.value;
          const password = passwordEl.value;

          // USING THE EXACT CODE STRUCTURE SUGGESTED BY YOUR JWT DASHBOARD:
          const options = {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ "username": username, "password": password })
          };

          try {
            const response = await fetch('https://api.amcd.com.au/wp-json/jwt-auth/v1/token', options);
            const data = await response.json();

            if (response.ok && data.token) {
              // Store parameters securely inside browser storage keys
              localStorage.setItem('wp_session_token', data.token);
              localStorage.setItem('wp_user_name', data.user_display_name);
              localStorage.setItem('wp_user_email', data.user_email);
              localStorage.setItem('wp_user_nicename', data.user_nicename);
              
              // Refresh screen state instantly
              window.location.reload();
            } else {
              if (errorAlert) {
                errorAlert.textContent = data.message || 'Authentication rejected by WordPress.';
                errorAlert.classList.remove('hidden');
              }
            }
          } catch (err) {
            if (errorAlert) {
              errorAlert.textContent = 'Network execution failure connecting to subdomain endpoint.';
              errorAlert.classList.remove('hidden');
            }
          }
        }
      });
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        localStorage.clear();
        window.location.reload();
      });
    }
  </script>
</body>
</html>
