---
import Layout from '../../layouts/Layout.astro';

const userres = await fetch("https://amcd.com.au/amcdwp/wp-json/wp/v2/users");
const users = await userres.json();

const base = "https://wilayah.id/api/";

const regionData = await fetch(`${base}regencies/51.json`);
const jsonResponse = await regionData.json();
const regions = jsonResponse.data || [];
import baliData from '../../data/bali.json';
import '../../style/global.css';

import PlacesForm from '../../components/PlacesForm.astro';

import locationData from '../../data/bali.json';
---


<Layout title="Users">


<PlacesForm />

<div>
  {locationData.map((regency) => {
    const districts = regency.districts || [];

    return (
      <div>
        <p><b>Regency:</b> {regency.regency_name}</p>
        {districts.map((district: any) => {
          const villages = district.villages || [];
          return (
            <div>
              <p><b>District:</b> {district.district_name}</p>
              {villages.map((village: any) => (

                <p> {village.village_name}</p>
                <p> {village.neighborhoods?.join(', ') || 'N/A'}</p>
              ))}
            </div>
          );
        })}
      </div>
    );
  })}
</div>

<div>
  {
    regions.map(async (region: any) => {
      const districtData = await fetch(`${base}districts/${region.code}.json`);
      const districtJsonResponse = await districtData.json();
      const districts = districtJsonResponse.data || [];

      return (
        <div class="region-container" style="margin-bottom: 30px; border-bottom: 1px solid #ccc; padding-bottom: 20px;">
          <h2><b>REGION:</b> {region.name}</h2>
          <small>Region Code: {region.code}</small>
          
          <div class="districts-list" style="margin-left: 20px;">
            {
              districts.map(async (district: any) => {
                // 1. Fetch the villages using the district code (e.g., 51.01.01.json)
                const villageData = await fetch(`${base}villages/${district.code}.json`);
                const villageJsonResponse = await villageData.json();
                const villages = villageJsonResponse.data || [];

                return (
                  <div class="district-container" style="margin-top: 15px;">
                    <h3><b>DISTRICT:</b> {district.name} ({district.code})</h3>
                    
                    {/* 2. Map through the fetched villages */}
                    <ul style="margin-left: 20px;">
                      {
                        villages.map((village: any) => (
                          <li>{village.name} <small style="color: #666;">({village.code})</small></li>
                        ))
                      }
                    </ul>
                  </div>
                );
              })
            }
          </div>
        </div>
      );
    })
  }
</div>

















    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

    {
        users.map((user: any) => {
        // 1. Strip HTML tags from the WordPress excerpt

        
            
        return (
            <a href={`/users/${user.slug}/`}
            class="post-card"
            data-title={user.name.toLowerCase()}
            >
                <div class="p-6 bg-white rounded-xl shadow-sm border border-slate-200">

                <h2 class="text-xl font-bold text-slate-900 h-15 mt-4">hello{user.name}</h2>
                    <img src={user.acf.profile_image.sizes.profile_thumbnail} alt="Descriptive alt text" />

                </div>
            </a>
        );
        })
    }

    </div> 
</Layout>