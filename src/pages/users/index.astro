---
import Layout from '../../layouts/Layout.astro';

// src/pages/users.astro
// This code executes strictly on the server before the page HTML is delivered to Vercel

const token = Astro.cookies.get('wp_jwt_token')?.value;
let userProfile = null;

// If a token exists, validate it or pull profile information directly to display state
if (token) {
  const response = await fetch('https://amcd.com.au', {
    headers: { 'Authorization': `Bearer ${token}` }
  });
  if (response.ok) {
    userProfile = await response.json();
  } else {
    // Token expired or invalid, scrub it cleanly
    Astro.cookies.delete('wp_jwt_token', { path: '/' });
  }
}
---


<Layout title="Users">

<h1>Log in page that will redirect to the users dashboard if token detected</h1>






  <div class="max-w-md mx-auto bg-white rounded-xl shadow-md border border-slate-100 p-6 mt-12">
    
    
</div>



</Layout>